FROM node:24-bookworm-slim AS build
RUN npm install --global pnpm@10.26.1
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ENV PORT=8080 BASE_PATH=/ NODE_ENV=production
RUN pnpm --filter @workspace/peoplematrix run build

FROM nginx:1.27-alpine
COPY artifacts/peoplematrix/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/artifacts/peoplematrix/dist/public /usr/share/nginx/html
EXPOSE 8080